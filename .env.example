# Copy this file to .env and replace the example values.
# Keep .env out of source control.
APP_PORT=8080

# Example only. Use the SQL Server host/database/user for your environment.
MSSQL_CONNECTION_STRING=Server=YOUR_SQL_SERVER;Database=YOUR_DATABASE;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True

# Use the Redis hostname reachable from inside the container.
REDIS_CONNECTION_STRING=Rabbit-srv:6379,abortConnect=false
