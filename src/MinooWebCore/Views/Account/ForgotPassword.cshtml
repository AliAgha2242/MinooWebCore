@{
    ViewData["Title"] = "فراموشی رمز عبور";
}
<main class="simple-page">
    <section class="simple-card">
        <div class="brand-mark">M<span>•</span></div>
        <p class="eyebrow">MINOO WEB CORE</p>
        <h1>فراموشی رمز عبور</h1>
        <p class="subtitle">این صفحه برای اتصال به فرایند بازیابی رمز عبور شما آماده شده است.</p>
        @if (TempData["Info"] is string message)
        {
            <p class="info-message">@message</p>
        }
        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()
            <label for="usernameOrEmail">نام کاربری یا ایمیل سازمانی</label>
            <div class="input-wrap"><input id="usernameOrEmail" name="usernameOrEmail" placeholder="نام کاربری یا ایمیل" /></div>
            <button type="submit" class="submit-button">ادامه</button>
        </form>
        <a class="back-link" asp-action="Login">بازگشت به صفحه ورود</a>
    </section>
</main>
