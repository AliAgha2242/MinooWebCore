@model IReadOnlyList<MinooWebCore.Data.Models.ReportDefinition>
@{
    ViewData["Title"] = "مدیریت گزارش‌ها";
    var menuItems = ViewBag.MenuItems as (string Key, string Title, string Description, string Icon)[] ?? [];
    var selectedSection = ViewBag.SelectedSection as string ?? "manage-reports";
    var selectedTitle = ViewBag.SelectedTitle as string ?? "مدیریت گزارش‌ها";
    var selectedDescription = ViewBag.SelectedDescription as string ?? "";
    var softwareGroupNames = ViewBag.SoftwareGroupNames as Dictionary<int, string> ?? [];
    var reportLevelNames = ViewBag.ReportLevelNames as Dictionary<int, string> ?? [];
    var serverNames = ViewBag.ServerNames as Dictionary<decimal, string> ?? [];
    var reportServerNames = ViewBag.ReportServerNames as Dictionary<int, string> ?? [];
}
<main class="admin-page">
    <aside class="admin-sidebar">
        <a class="admin-brand" asp-controller="Home" asp-action="Index">
            <span class="brand-mark">M<span>•</span></span>
            <span class="brand-copy"><strong>MINOO</strong><span>WEB CORE</span></span>
        </a>
        <div class="admin-sidebar-label">مدیریت سامانه</div>
        <nav class="admin-menu" aria-label="منوی مدیریت">
            @foreach (var item in menuItems)
            {
                <a class="admin-menu-link @(selectedSection == item.Key ? "active" : "")"
                   asp-controller="Admin" asp-action="@(item.Key == "manage-reports" ? "ManageReports" : "Index")">
                    <span class="admin-menu-icon">@item.Icon</span>
                    <span>@item.Title</span>
                    @if (selectedSection == item.Key) { <span class="admin-menu-active-dot"></span> }
                </a>
            }
        </nav>
        <a class="admin-back-link" asp-controller="Home" asp-action="Index"><span>←</span> بازگشت به صفحه اصلی</a>
    </aside>

    <section class="admin-main">
        <header class="admin-topbar">
            <div>
                <span class="admin-breadcrumb">MINOO / ADMINISTRATION</span>
                <h1>پنل مدیریت</h1>
            </div>
            <a class="admin-profile" asp-controller="Profile" asp-action="Index">
                <span class="admin-profile-avatar" data-user-avatar>@(User.Identity?.Name?.Length > 0 ? User.Identity.Name[..1].ToUpperInvariant() : "م")</span>
                <span>@User.Identity?.Name</span>
            </a>
        </header>

        <div class="admin-welcome">
            <div>
                <span class="admin-eyebrow"><span class="status-dot"></span> فضای مدیریت</span>
                <h2>@selectedTitle</h2>
                <p>@selectedDescription</p>
            </div>
            <span class="admin-welcome-symbol">M<span>•</span></span>
        </div>

        @if (TempData["AdminSuccessMessage"] is string successMessage)
        {
            <div class="report-message report-message-success" role="status"><span>✓</span>@successMessage</div>
        }

        <section class="report-builder">
            <div class="report-parameters-heading report-list-heading">
                <div>
                    <span class="report-step">گزارش‌های ثبت‌شده</span>
                    <h3>فهرست گزارش‌ها</h3>
                    <p>از این قسمت می‌توانید گزارش‌ها را ویرایش یا به‌صورت نرم حذف کنید.</p>
                </div>
                <a asp-controller="Admin" asp-action="Index" class="report-add-parameter">＋ ایجاد گزارش جدید</a>
            </div>

            @if (Model.Count == 0)
            {
                <div class="report-empty-parameters">هنوز گزارشی ثبت نشده است.</div>
            }
            else
            {
                <div class="report-table-wrapper">
                    <table class="report-table">
                        <thead>
                            <tr>
                                <th>نام گزارش</th>
                                <th>منبع</th>
                                <th>گروه نرم‌افزاری</th>
                                <th>سطح</th>
                                <th>سرور</th>
                                <th>صفحه‌بندی</th>
                                <th>تاریخ ایجاد (UTC)</th>
                                <th>عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var report in Model)
                        {
                            <tr>
                                <td class="report-name-cell">@report.Name</td>
                                <td><span class="report-source-badge">@((report.SourceType == "Excel") ? "Excel" : "SQL")</span></td>
                                <td>@(softwareGroupNames.TryGetValue(report.SoftwareGroupId, out var groupName) ? groupName : "—")</td>
                                <td>@(reportLevelNames.TryGetValue(report.ReportLevelId, out var levelName) ? levelName : "—")</td>
                                <td>@(report.UseDefaultServer ? "سرور پیش‌فرض کاربر" : reportServerNames.TryGetValue(report.Id, out var selectedServers) ? selectedServers : "سرورهای انتخابی")</td>
                                <td>@(report.NeedsPagination ? $"بله · {report.PageSize} رکورد" : "خیر")</td>
                                <td dir="ltr">@report.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <div class="report-row-actions">
                                        <a asp-controller="Admin" asp-action="Edit" asp-route-id="@report.Id" class="report-edit-button">ویرایش</a>
                                        <form asp-controller="Admin" asp-action="DeleteReport" method="post" onsubmit="return confirm('گزارش حذف شود؟ این عملیات Soft Delete است.');">
                                            <input type="hidden" name="id" value="@report.Id" />
                                            <button type="submit" class="report-delete-button">حذف</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <footer class="admin-footer"><span>© @DateTime.Now.Year گروه صنعتی مینو</span><span>MINOO WEB CORE · ADMIN</span></footer>
    </section>
</main>
