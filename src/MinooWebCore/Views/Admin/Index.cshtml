@model MinooWebCore.Controllers.AdminController.CreateReportInput
@using System.Text.Json
@{
    ViewData["Title"] = "ایجاد گزارش";
    var menuItems = ViewBag.MenuItems as (string Key, string Title, string Description, string Icon)[] ?? [];
    var selectedSection = ViewBag.SelectedSection as string ?? "create-report";
    var selectedTitle = ViewBag.SelectedTitle as string ?? "ایجاد گزارش";
    var selectedDescription = ViewBag.SelectedDescription as string ?? "";
    var savedParameters = JsonSerializer.Serialize(Model.Parameters);
    var isEdit = ViewBag.IsEdit is bool editMode && editMode;
    var hasExistingExcel = !string.IsNullOrWhiteSpace(Model.ExistingExcelFileName);
}
<main class="admin-page">
    <aside class="admin-sidebar">
        <a class="admin-brand" asp-controller="Home" asp-action="Index">
            <span class="brand-mark">M<span>•</span></span>
            <span class="brand-copy"><strong>MINOO</strong><span>WEB CORE</span></span>
        </a>
        <div class="admin-sidebar-label">مدیریت سامانه</div>
        <nav class="admin-menu" aria-label="منوی مدیریت">
            @foreach (var item in menuItems)
            {
                <a class="admin-menu-link @(selectedSection == item.Key ? "active" : "")"
                   asp-controller="Admin" asp-action="Index" asp-route-section="@item.Key">
                    <span class="admin-menu-icon">@item.Icon</span>
                    <span>@item.Title</span>
                    @if (selectedSection == item.Key) { <span class="admin-menu-active-dot"></span> }
                </a>
            }
        </nav>
        <a class="admin-back-link" href="@Url.Action("Index", "Home")" onclick="if (window.history.length > 1) { window.history.back(); return false; }"><span>←</span> بازگشت به صفحه قبل</a>
    </aside>

    <section class="admin-main">
        <header class="admin-topbar">
            <div>
                <span class="admin-breadcrumb">MINOO / ADMINISTRATION</span>
                <h1>پنل مدیریت</h1>
            </div>
            <a class="admin-profile" asp-controller="Profile" asp-action="Index">
                <span class="admin-profile-avatar" data-user-avatar>@(User.Identity?.Name?.Length > 0 ? User.Identity.Name[..1].ToUpperInvariant() : "م")</span>
                <span>@User.Identity?.Name</span>
            </a>
        </header>

        <div class="admin-welcome">
            <div>
                <span class="admin-eyebrow"><span class="status-dot"></span> فضای مدیریت</span>
                <h2>@selectedTitle</h2>
                <p>@selectedDescription</p>
            </div>
            <span class="admin-welcome-symbol">M<span>•</span></span>
        </div>

        <section class="report-builder">
            <div class="report-builder-heading">
                <div>
                    <span class="report-step">مرحله ۱ · مشخصات و منبع</span>
                    <h3>تعریف گزارش جدید</h3>
                    <p>نام گزارش و منبع داده را مشخص کنید؛ سپس پارامترهای ورودی گزارش را تعریف کنید.</p>
                </div>
                <span class="report-builder-icon">▤</span>
            </div>

            @if (TempData["AdminSuccessMessage"] is string adminSuccess)
            {
                <div class="report-message report-message-success" role="status"><span>✓</span>@adminSuccess</div>
            }
            @if (ViewBag.SuccessMessage is string successMessage)
            {
                <div class="report-message report-message-success" role="status"><span>✓</span>@successMessage</div>
            }
            <div asp-validation-summary="All" class="report-validation-summary"></div>

            <form asp-controller="Admin" asp-action="@(isEdit ? "UpdateReport" : "CreateReport")" method="post" enctype="multipart/form-data" class="report-form" id="reportForm">
                @if (isEdit)
                {
                    <input asp-for="ReportId" type="hidden" />
                }
                <section class="report-form-section">
                    <div class="report-section-heading"><span class="report-step">بخش ۱</span><div><h3>مشخصات اصلی</h3><p>نام گزارش و نوع منبع داده را مشخص کنید.</p></div></div>
                    <div class="report-basic-grid">
                        <div class="report-field">
                            <label asp-for="ReportName">نام گزارش</label>
                            <input asp-for="ReportName" type="text" maxlength="150" placeholder="مثلاً گزارش فروش ماهانه" autocomplete="off" required />
                            <span asp-validation-for="ReportName" class="report-field-error"></span>
                        </div>
                        <div class="report-field">
                            <label asp-for="Source">منبع گزارش</label>
                            <select asp-for="Source" id="reportSource">
                                <option value="Excel">فایل Excel</option><option value="Sql">پایگاه داده SQL</option>
                            </select>
                            <span asp-validation-for="Source" class="report-field-error"></span>
                        </div>
                    </div>
                </section>
                <section class="report-form-section">
                    <div class="report-section-heading"><span class="report-step">بخش ۲</span><div><h3>تنظیمات منبع داده</h3><p>فایل اکسل یا Query گزارش را مشخص کنید.</p></div></div>
                <div id="excelOptions" class="report-source-panel">
                    <div class="report-field">
                        <label asp-for="ExcelFile">فایل اکسل گزارش</label>
                        <div class="report-file-control">
                            <input asp-for="ExcelFile" type="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" id="excelFile" />
                            <span class="report-file-hint">فرمت مجاز: .xlsx · حداکثر حجم: ۲۰ مگابایت</span>
                        </div>
                        <span asp-validation-for="ExcelFile" class="report-field-error"></span>
                        <span class="report-field-help">فایل باید دقیقاً یک شیت داشته باشد و تمام ستون‌ها در ردیف اول دارای عنوان باشند.</span>
                        @if (isEdit && !string.IsNullOrWhiteSpace(Model.ExistingExcelFileName))
                        {
                            <span class="report-field-help">فایل فعلی: @Model.ExistingExcelFileName (برای جایگزینی، فایل جدید انتخاب کنید.)</span>
                        }
                    </div>
                </div>

                <div id="sqlOptions" class="report-source-panel" hidden>
                    <div class="report-field">
                        <label asp-for="SqlQuery">Query گزارش</label>
                        <textarea asp-for="SqlQuery" id="sqlQuery" maxlength="100000" rows="7" dir="ltr" spellcheck="false" placeholder="SELECT ... FROM ..."></textarea>
                        <span asp-validation-for="SqlQuery" class="report-field-error"></span>
                        <span class="report-field-help">فعلاً Query فقط دریافت و اعتبارسنجی اولیه می‌شود و اجرا نخواهد شد.</span>
                    </div>
                </div>

                </section>
                <section class="report-form-section">
                    <div class="report-section-heading"><span class="report-step">بخش ۳</span><div><h3>تنظیمات نمایش</h3><p>در صورت نیاز، تعداد رکوردهای هر صفحه را تعیین کنید.</p></div></div>
                <div class="report-pagination">
                    <label class="report-checkbox">
                        <input asp-for="NeedsPagination" id="needsPagination" type="checkbox" />
                        <span class="report-checkbox-mark"></span>
                        <span class="report-checkbox-copy"><strong>این گزارش به صفحه‌بندی نیاز دارد</strong><small>تعداد رکوردهای قابل نمایش در هر صفحه را تعیین کنید.</small></span>
                    </label>
                    <div class="report-field report-page-size" id="pageSizeField" hidden>
                        <label asp-for="PageSize">تعداد رکورد در هر صفحه</label>
                        <input asp-for="PageSize" type="number" min="1" max="50000" step="1" placeholder="مثلاً ۲۰" />
                        <span asp-validation-for="PageSize" class="report-field-error"></span>
                    </div>
                </div>

                </section>
                <section class="report-parameters report-form-section">
                    <div class="report-parameters-heading">
                        <div>
                            <span class="report-step">بخش ۴ · پارامترهای ورودی</span>
                            <h3>تعریف پارامترهای گزارش</h3>
                            <p>مشخص کنید کاربر هنگام مشاهده گزارش چه مقادیری را وارد یا انتخاب کند.</p>
                        </div>
                        <button type="button" class="report-add-parameter" id="addParameter">＋ افزودن پارامتر</button>
                    </div>
                    <div id="parameterList" class="report-parameter-list"></div>
                    <div id="emptyParameters" class="report-empty-parameters">هنوز پارامتری تعریف نشده است. در صورت نیاز، «افزودن پارامتر» را انتخاب کنید.</div>
                </section>

                <div class="report-form-actions">
                    <button type="submit" class="report-submit-button"><span>✓</span> @(isEdit ? "ذخیره تغییرات" : "ذخیره گزارش")</button>
                    <a asp-controller="Admin" asp-action="ManageReports" class="report-cancel-button">مدیریت گزارش‌ها</a>
                </div>
            </form>
        </section>

        <footer class="admin-footer"><span>© @DateTime.Now.Year گروه صنعتی مینو</span><span>MINOO WEB CORE · ADMIN</span></footer>
    </section>
</main>

@section Scripts {
    <script>
        (() => {
            const source = document.getElementById('reportSource');
            const isEdit = @isEdit.ToString().ToLowerInvariant();
            const hasExistingExcel = @hasExistingExcel.ToString().ToLowerInvariant();
            const excelOptions = document.getElementById('excelOptions');
            const excelFile = document.getElementById('excelFile');
            const sqlOptions = document.getElementById('sqlOptions');
            const sqlQuery = document.getElementById('sqlQuery');
            const pagination = document.getElementById('needsPagination');
            const pageSizeField = document.getElementById('pageSizeField');
            const pageSizeInput = pageSizeField.querySelector('input');
            const parameterList = document.getElementById('parameterList');
            const emptyParameters = document.getElementById('emptyParameters');
            let parameterIndex = 0;

            function updateSourceFields() {
                const isExcel = source.value === 'Excel';
                excelOptions.hidden = !isExcel;
                sqlOptions.hidden = isExcel;
                excelFile.required = isExcel && !(isEdit && hasExistingExcel);
                sqlQuery.required = !isExcel;
                if (!isExcel) excelFile.value = '';
            }

            function updatePagination() {
                pageSizeField.hidden = !pagination.checked;
                pageSizeInput.required = pagination.checked;
                if (!pagination.checked) pageSizeInput.value = '';
            }

            function updateParameterType(row) {
                const type = row.querySelector('.parameter-type').value;
                row.querySelectorAll('[data-for-type]').forEach(element => {
                    const visible = element.dataset.forType.split(' ').includes(type);
                    element.hidden = !visible;
                    element.querySelectorAll('input, textarea').forEach(field => field.required = visible);
                });
            }

            function addParameter(parameter = {}) {
                if (parameterList.querySelectorAll('.report-parameter-card').length >= 30) {
                    alert('حداکثر ۳۰ پارامتر می‌توانید تعریف کنید.');
                    return;
                }
                const index = parameterIndex++;
                const row = document.createElement('div');
                row.className = 'report-parameter-card';
                row.innerHTML = `
                    <div class="report-parameter-card-head">
                        <strong>پارامتر <span class="parameter-number">${index + 1}</span></strong>
                        <button type="button" class="report-remove-parameter" aria-label="حذف پارامتر">حذف ×</button>
                    </div>
                    <div class="report-parameter-grid">
                        <div class="report-field">
                            <label>نام فنی پارامتر</label>
                            <input name="Parameters[${index}].Name" type="text" maxlength="64" pattern="[A-Za-z_][A-Za-z0-9_]*" dir="ltr" placeholder="FromDate" required />
                        </div>
                        <div class="report-field">
                            <label>عنوان نمایشی</label>
                            <input name="Parameters[${index}].DisplayName" type="text" maxlength="100" placeholder="از تاریخ" required />
                        </div>
                        <div class="report-field">
                            <label>نوع کنترل</label>
                            <select name="Parameters[${index}].Type" class="parameter-type">
                                <option value="Text">متن</option>
                                <option value="Number">عدد</option>
                                <option value="Date">تاریخ (ورودی متنی)</option>
                                <option value="Checkbox">چک‌باکس</option>
                                <option value="RadioButton">رادیوباتن</option>
                                <option value="ListBox">لیست‌باکس</option>
                            </select>
                        </div>
                        <div class="report-field parameter-extra" data-for-type="RadioButton">
                            <label>گزینه‌های رادیوباتن</label>
                            <textarea name="Parameters[${index}].Options" maxlength="5000" rows="3" placeholder="هر گزینه در یک خط"></textarea>
                        </div>
                        <div class="report-field parameter-extra parameter-list-source" data-for-type="ListBox">
                            <label>Query منبع گزینه‌های لیست‌باکس</label>
                            <textarea name="Parameters[${index}].DataSource" maxlength="10000" rows="4" dir="ltr" spellcheck="false" placeholder="SELECT Id, Title FROM ..."></textarea>
                        </div>
                        <div class="report-field parameter-extra" data-for-type="ListBox">
                            <label>نام ستون نمایشی (DisplayName)</label>
                            <input name="Parameters[${index}].DisplayNameField" type="text" maxlength="128" dir="ltr" placeholder="Title" />
                        </div>
                        <div class="report-field parameter-extra" data-for-type="ListBox">
                            <label>نام ستون مقدار (ValueName)</label>
                            <input name="Parameters[${index}].ValueField" type="text" maxlength="128" dir="ltr" placeholder="Id" />
                        </div>
                    </div>`;
                row.querySelector(`[name="Parameters[${index}].Name"]`).value = parameter.name || '';
                row.querySelector(`[name="Parameters[${index}].DisplayName"]`).value = parameter.displayName || '';
                row.querySelector(`[name="Parameters[${index}].Type"]`).value = parameter.type || 'Text';
                row.querySelector(`[name="Parameters[${index}].DataSource"]`).value = parameter.dataSource || '';
                row.querySelector(`[name="Parameters[${index}].DisplayNameField"]`).value = parameter.displayNameField || '';
                row.querySelector(`[name="Parameters[${index}].ValueField"]`).value = parameter.valueField || '';
                row.querySelector(`[name="Parameters[${index}].Options"]`).value = parameter.options || '';
                row.querySelector('.parameter-type').addEventListener('change', () => updateParameterType(row));
                row.querySelector('.report-remove-parameter').addEventListener('click', () => {
                    row.remove();
                    refreshParameterNumbers();
                });
                parameterList.appendChild(row);
                updateParameterType(row);
                refreshParameterNumbers();
            }

            function refreshParameterNumbers() {
                const rows = [...parameterList.querySelectorAll('.report-parameter-card')];
                rows.forEach((row, index) => {
                    row.querySelector('.parameter-number').textContent = index + 1;
                    row.querySelectorAll('[name^="Parameters["]').forEach(field => {
                        const propertyName = field.name.substring(field.name.lastIndexOf('].') + 2);
                        field.name = `Parameters[${index}].${propertyName}`;
                    });
                });
                emptyParameters.hidden = rows.length > 0;
            }

            document.getElementById('addParameter').addEventListener('click', () => addParameter());
            document.getElementById('reportForm').addEventListener('submit', event => {
                refreshParameterNumbers();
                if (!event.currentTarget.checkValidity()) { event.preventDefault(); event.currentTarget.reportValidity(); }
            });
            source.addEventListener('change', updateSourceFields);
            pagination.addEventListener('change', updatePagination);
            updateSourceFields();
            updatePagination();

            const existingParameters = @Html.Raw(savedParameters);
            existingParameters.forEach(parameter => addParameter({
                name: parameter.Name, displayName: parameter.DisplayName, type: parameter.Type,
                dataSource: parameter.DataSource, displayNameField: parameter.DisplayNameField,
                valueField: parameter.ValueField, options: parameter.Options
            }));
            refreshParameterNumbers();
        })();
    </script>
}
